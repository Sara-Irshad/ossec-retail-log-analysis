<!-- Modify it at your will. -->

<group name="local,syslog,">

  <!-- Note that rule id 5711 is defined at the ssh_rules file
    -  as a ssh failed login. This is just an example
    -  since ip 192.0.2.1 shouldn't be used anywhere.
    -  Level 0 means ignore.
    -->
  <rule id="100001" level="0">
    <if_sid>5711</if_sid>
    <srcip>192.0.2.1</srcip>
    <description>Example of rule that will ignore sshd </description>
    <description>failed logins from IP 1.1.1.1.</description>
  </rule>
  
  
  <!-- This example will ignore ssh failed logins for the user name XYZABC.
    -->
  <!--  
  <rule id="100020" level="0">
    <if_sid>5711</if_sid>
    <user_pcre2>XYZABC</user_pcre2>
    <description>Example of rule that will ignore sshd </description>
    <description>failed logins for user XYZABC.</description>
  </rule>
  -->
  
  
  <!-- Specify here a list of rules to ignore. -->
  <!--
  <rule id="100030" level="0">
    <if_sid>12345, 23456, xyz, abc</if_sid>
    <description>List of rules to be ignored.</description>
  </rule>
  -->

<rule id="100010" level="5">
<if_sid>5716</if_sid>
<description>Failed login attempt detected on POS admin terminal (SSH).</description>
<group>retail_pos,authentication_failed,</group>
</rule>

<rule id="100011" level="10" frequency="6" timeframe="120">
<if_matched_sid>100010</if_matched_sid>
<description>Possible brute-force attack against POS admin  terminal - 6+ failed logins within 2 minutes.</description>
<group>retail_pos,authentication_failures,</group>
</rule>

<rule id="100012" level="8">
<match>new user</match>
<description>Unauthorised user account created on retail server.</description>
<group>retail_pos,account_changes,</group>
</rule>

<rule id="100013" level="6">
<match>sudo:</match>
<description>Privileged command executed on retail POS server - review for unauthorised admin activity.</description>
<group>retail_pos,privilege_escalation,</group>
</rule>

<rule id="100014" level="7">
<if_sid>550</if_sid>
<match>pos_config.conf</match>
<description>Unexpected  modification to POS configuration file detected by file integrity monitoring.</description>
</rule>     
</group> <!-- SYSLOG,LOCAL -->


<!-- EOF -->
